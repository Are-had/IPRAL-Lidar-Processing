    given-names: Arezki
    email: arezki.haddouche@lmd.ipsl.fr
    affiliation: "Laboratoire de Météorologie Dynamique (LMD/IPSL), École Polytechnique, Palaiseau, France"
  - family-names: Feofilov
    given-names: Artem
    email: afeofilo@lmd.ipsl.fr
    affiliation: "Laboratoire de Météorologie Dynamique (LMD/IPSL), École Polytechnique, Palaiseau, France"